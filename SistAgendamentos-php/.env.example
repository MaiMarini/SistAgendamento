APP_NAME="SistAgendamentos"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

# URL do frontend — usado em links de email (reset de senha, convite, etc.)
FRONTEND_URL=http://localhost:8081

# Tempo de expiração dos links de convite/reset (em horas)
INVITE_LINK_EXPIRATION_HOURS=24
PASSWORD_RESET_EXPIRATION_HOURS=1

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Banco de dados — MySQL (Laragon local) ou MySQL da HostGator (produção)
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sistagendamentos
DB_USERNAME=root
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Sessão / cache (em produção HostGator: usar database, não redis)
# ---------------------------------------------------------------------------
BROADCAST_CONNECTION=log
CACHE_STORE=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# ---------------------------------------------------------------------------
# Sanctum — domínios autorizados a usar tokens
# Em produção, listar o domínio do app/site (ex: kallme.com.br,api.kallme.com.br)
# ---------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8081,127.0.0.1,127.0.0.1:8000

# ---------------------------------------------------------------------------
# Email (SMTP)
# Local: usar Mailtrap, MailHog, ou log driver
# Produção: SMTP da HostGator (criar email no cPanel primeiro)
#   MAIL_HOST=mail.kallme.com.br
#   MAIL_PORT=465
#   MAIL_ENCRYPTION=ssl
#   MAIL_USERNAME=naoresponda@kallme.com.br
#   MAIL_PASSWORD=<senha do email criado no cPanel>
#   MAIL_FROM_ADDRESS=naoresponda@kallme.com.br
#   MAIL_FROM_NAME="Sistema de Agendamentos"
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="naoresponda@kallme.com.br"
MAIL_FROM_NAME="Sistema de Agendamentos"

# ---------------------------------------------------------------------------
# CORS — origens autorizadas a chamar a API
# Em produção, listar exatamente o domínio do app/site
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS="http://localhost:8081,http://localhost:19006"
